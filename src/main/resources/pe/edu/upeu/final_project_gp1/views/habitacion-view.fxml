<?xml version="1.0" encoding="UTF-8"?>


<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.final_project_gp1.controller.HabitacionController">
    <padding>
        <Insets bottom="20.0 " left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestión de habitaciones" textFill="#014074">
                    <font>
                        <Font name="System bold" size="20.0"/>
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS"/>
                <Button mnemonicParsing="false" styleClass="button-login" text="+ NUEVO"/>
            </children>
        </HBox>

        <TableView fx:id="tableHabitacion" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="ColNum" prefWidth="50.0" text="#"/>
                <TableColumn fx:id="ColId" prefWidth="50.0" text="ID" visible="false"/>
                <TableColumn fx:id="ColNumero" prefWidth="100.0" text="Numero"/>
                <TableColumn fx:id="ColNumeroPiso" prefWidth="100.0" text="Numero piso"/>
                <TableColumn fx:id="ColNumeroHabitacion" prefWidth="100.0" text="Numero habitacion"/>
                <TableColumn fx:id="ColTipo" prefWidth="100.0" text="Tipo"/>
                <TableColumn fx:id="ColPrecio" prefWidth="80.0" text="Precio"/>
                <TableColumn fx:id="ColEstado" prefWidth="80.0" text="Estado"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-edit" text="EDITAR"/>

                <Button mnemonicParsing="false" onAction="#handleDelete" styleClass="button-action-delete" text="ELIMINAR"/>
            </children>
        </HBox>
    </children>

</VBox>
