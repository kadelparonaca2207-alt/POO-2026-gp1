<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.final_project_gp1.controller.ReservaFormController" spacing="15.0" stylesheets="@style.css" style="-fx-background-color: white">
    <padding>
        <Insets bottom="50.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <children>
        <Label text="Nueva Reserva" textFill="#014874">
            <font><Font name = "System Bold" size="18.0"/></font>
        </Label>
        <Separator/>
        <GridPane hgap="10.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints prefWidth="120"/>
                <ColumnConstraints prefWidth="200"/>
                <ColumnConstraints prefWidth="150"/>
            </columnConstraints>
            <children>
                <!--Búsqueda del cliente-->
                <Label text="DNI cliente" GridPane.rowIndex="0"/>
                <TextField fx:id="txtDniBusqueda" promptText="Presione Enter" onKeyReleased="#buscarCliente" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label fx:id="lblNombreCliente" text="Cliente no encontrado" textFill="#999999" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <!--Búsqueda de habitacion-->
                <Label text="N° Habitación" GridPane.rowIndex="1"/>
                <TextField  fx:id="txtNumeroHab" promptText="Presione Enter" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Habitación no encontrada" textFill="#999999" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <!--fechas-->
                <Label text="Fecha Ingreso" GridPane.rowIndex="2"/>
                <DatePicker maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Fecha Salida" GridPane.rowIndex="3"/>
                <DatePicker maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Total (S/. " GridPane.rowIndex="4"/>
                <TextField promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </children>
        </GridPane>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleCancelar" mnemonicParsing="false" prefHeight="31.0" prefWidth="100.0" styleClass="button-action-delete" text="Cancelar"/>
                <Button mnemonicParsing="false" prefHeight="31.0" prefWidth="100.0" styleClass="button-action-edit" text="Guardar"/>
            </children>
        </HBox>
    </children>

</VBox>
