<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20.0" style="-fx-background-color: #F7F7F7" stylesheets="@style.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.final_project_gp1.controller.ReservaController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Label text="Gestión de reservas" textFill="#014074">
                    <font>
                        <Font name="System bold" size="20.0" />
                    </font>
                </Label>
                <Region HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" styleClass="button-login" text="+ NUEVO" />
            </children>
        </HBox>

        <TableView VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="" prefWidth="40.0" text="N" />
                <TableColumn fx:id="" prefWidth="10.0" text="ID" visible="false" />
                <TableColumn fx:id="" prefWidth="150.0" text="Cliente" />
                <TableColumn fx:id="" prefWidth="150.0" text="Habitación" />
                <TableColumn fx:id="" prefWidth="90.0" text="Ingreso" />
                <TableColumn fx:id="" prefWidth="180.0" text="Salida" />
                <TableColumn fx:id="" prefWidth="70.0" text="Total" />
                <TableColumn fx:id="" prefWidth="70.0" text="Estado" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button mnemonicParsing="false" styleClass="button-action-edit" text="Check-in" />
                <Button mnemonicParsing="false" styleClass="button-action-edit" text="Check-out" />
                <Button mnemonicParsing="false" styleClass="button-action-cancel" text="Cancelar" />
            </children>
        </HBox>
    </children>

</VBox>
